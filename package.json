{
  "name": "tsi-atividade-back-end-25-05",
  "version": "1.0.0",
  "description": "API REST para gerenciamento de jogos digitais",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
